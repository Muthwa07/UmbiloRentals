<!--
  TEMPLATE - copy this file to Web.Secrets.config (same folder) and fill
  in a real API key. Web.Secrets.config itself is gitignored and will
  never be committed - that's the whole point. This template file IS
  committed, so anyone setting up the project knows what's needed.

  To get a key: SendGrid dashboard -> Settings -> API Keys -> Create
  API Key -> Restricted Access -> enable "Mail Send" only.
-->
<mailSettings>
  <smtp from="umbilorentals@gmail.com">
    <network host="smtp.sendgrid.net"
              port="587"
              enableSsl="true"
              userName="apikey"
              password="REPLACE_WITH_YOUR_SENDGRID_API_KEY" />
  </smtp>
</mailSettings>
