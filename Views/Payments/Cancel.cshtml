@{
    ViewBag.Title = "Payment Cancelled";
}

<div class="account-page">

    <div class="account-card">

        <icon name=circle-x color=danger size=2xl />

        <h1>Payment Cancelled</h1>

        <p>@ViewBag.Message</p>

        @Html.ActionLink(
            "Try Again",
            "Dashboard",
            "Account",
            null,
            new { @class = "btn-register" })

    </div>

</div>