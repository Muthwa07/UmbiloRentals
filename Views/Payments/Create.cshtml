@{
    ViewBag.Title = "Make Payment";
}

<div class="account-page">

    <div class="account-card">

        <div class="account-header">

            <h1>Make Payment</h1>

            <p>Upload your proof of payment.</p>

        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @using (Html.BeginForm("Create", "Payments",
        FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="roomID"
                   value="@ViewBag.RoomID" />

            <div class="form-group">

                <label>Room</label>

                <input class="form-control"
                       value="Room @ViewBag.RoomNumber"
                       readonly />

            </div>

            <div class="form-group">

                <label>Amount</label>

                <input name="amount"
                       class="form-control"
                       value="@ViewBag.Amount"
                       readonly />

            </div>

            <div class="form-group">

                <label>Payment Month</label>

                <input name="paymentMonth"
                       class="form-control"
                       placeholder="September 2026"
                       required />

            </div>

            <div class="form-group">

                <label>Proof of Payment</label>

                <input type="file"
                       name="proof"
                       class="form-control"
                       accept=".pdf,.jpg,.jpeg,.png"
                       required />

                <small>Maximum 5 MB</small>

            </div>

            <button class="btn-register">
                Submit Payment
            </button>

        }

    </div>

</div>