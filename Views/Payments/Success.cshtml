@{
    ViewBag.Title = "Payment Successful";
}

<div class="account-page">

    <div class="account-card">

        <icon name=circle-check color=success size=2xl />

        <h1>Payment Received</h1>

        <p>@ViewBag.Message</p>

        @Html.ActionLink(
            "Back to Dashboard",
            "Dashboard",
            "Account",
            null,
            new { @class = "btn-register" })

    </div>

</div>