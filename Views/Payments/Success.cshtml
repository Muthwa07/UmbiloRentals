@{
    ViewBag.Title = "Payment Successful";
}

<div class="account-page">

    <div class="account-card">

        <i class="bi bi-check-circle-fill icon-success icon-2xl"></i>

        <h1>Payment Received</h1>

        <p>@ViewBag.Message</p>

        @Html.ActionLink(
            "Back to Dashboard",
            "Dashboard",
            "Account",
            null,
            new { @class = "btn-register" })

    </div>

</div>