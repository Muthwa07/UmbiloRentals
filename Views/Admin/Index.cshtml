@{
    ViewBag.Title = "Admin Dashboard";

    int totalRooms = ViewBag.AvailableRooms + ViewBag.OccupiedRooms;
    int occupied = ViewBag.OccupiedRooms;
    int occupancy = totalRooms > 0 ? (occupied * 100) / totalRooms : 0;
}

<div class="admin-page">

    <!-- Hero -->

    <div class="admin-hero glass-card">

        <div>

            <row gap=2 align=center>
                <i class="bi bi-shield-check icon-discovery icon-lg"></i>
                <h1>Welcome back, Admin</h1>
            </row>

            <p>
                Here's what's happening across Umbilo Rentals today.
            </p>

        </div>

        <div class="occupancy-ring">

            <svg viewBox="0 0 120 120">

                <circle cx="60" cy="60" r="48" class="ring-bg" />

                <circle cx="60"
                        cy="60"
                        r="48"
                        class="ring-progress"
                        style="stroke-dasharray:@(occupancy * 3.02) 302" />

            </svg>

            <div class="ring-text">

                <strong>@occupancy%</strong>

                <span>Occupied</span>

            </div>

        </div>

    </div>

    <!-- Stats -->

    <div class="admin-grid">

        <div class="stat-card applicants">
            <i class="bi bi-people-fill icon-info icon-2xl"></i>
            <span>Applicants</span>
            <h2>@ViewBag.TotalUsers</h2>
        </div>

        <div class="stat-card pending">
            <i class="bi bi-clipboard-fill icon-danger icon-2xl"></i>
            <span>Pending Applications</span>
            <h2>@ViewBag.PendingApplications</h2>
        </div>

        <div class="stat-card available">
            <i class="bi bi-door-open-fill icon-success icon-2xl"></i>
            <span>Available Rooms</span>
            <h2>@ViewBag.AvailableRooms</h2>
        </div>

        <div class="stat-card occupied">
            <i class="bi bi-moon-stars-fill icon-discovery icon-2xl"></i>
            <span>Occupied Rooms</span>
            <h2>@ViewBag.OccupiedRooms</h2>
        </div>

        <div class="stat-card payments">
            <i class="bi bi-credit-card-fill icon-info icon-2xl"></i>
            <span>Pending Payments</span>
            <h2>@ViewBag.PendingPayments</h2>
        </div>

        <div class="stat-card maintenance">
            <i class="bi bi-wrench icon-danger icon-2xl"></i>
            <span>Open Maintenance</span>
            <h2>@ViewBag.PendingMaintenance</h2>
        </div>

    </div>

    <!-- Bottom -->

    <div class="admin-bottom">

        <!-- Quick Actions -->

        <div class="glass-card quick-actions">

            <h2>Quick Actions</h2>

            <div class="action-grid">

                @Html.ActionLink(
                    "Review Applications",
                    "Applications",
                    "Admin",
                    null,
                    new { @class = "action-btn" })

                @Html.ActionLink(
                    "Manage Rooms",
                    "Rooms",
                    "Admin",
                    null,
                    new { @class = "action-btn" })

                @Html.ActionLink(
                    "Verify Payments",
                    "Payments",
                    "Admin",
                    null,
                    new { @class = "action-btn" })

            </div>

        </div>

        <!-- Overview -->

        <div class="glass-card activity-card">

            <h2>Today's Overview</h2>

            <div class="overview-list">

                <div class="overview-item">

                    <i class="bi bi-check-circle-fill icon-success"></i>

                    <div>

                        <strong>@ViewBag.OccupiedRooms Rooms Occupied</strong>

                        <p>Current active residents.</p>

                    </div>

                </div>

                <div class="overview-item">

                    <i class="bi bi-clock-fill icon-warning"></i>

                    <div>

                        <strong>@ViewBag.PendingApplications Applications Awaiting Review</strong>

                        <p>Applicants waiting for approval.</p>

                    </div>

                </div>

                <div class="overview-item">

                    <i class="bi bi-credit-card-fill icon-info"></i>

                    <div>

                        <strong>@ViewBag.PendingPayments Payments Need Verification</strong>

                        <p>Review uploaded proof of payment.</p>

                    </div>

                </div>

                <div class="overview-item">

                    <i class="bi bi-wrench icon-danger"></i>

                    <div>

                        <strong>@ViewBag.PendingMaintenance Maintenance Jobs Open</strong>

                        <p>Handled by the Maintenance Team.</p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>