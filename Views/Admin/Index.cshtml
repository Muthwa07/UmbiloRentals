@{
    ViewBag.Title = "Admin Dashboard";
}

<div class="admin-page">

    <div class="admin-header">

        <h1>Admin Dashboard</h1>

        <p>
            Manage Umbilo Rentals from one place.
        </p>

    </div>

    <div class="admin-grid">

        <div class="admin-card">
            <h2>@ViewBag.PendingApplications</h2>
            <p>Pending Applications</p>
        </div>

        <div class="admin-card">
            <h2>@ViewBag.ApprovedApplications</h2>
            <p>Approved Applications</p>
        </div>

        <div class="admin-card">
            <h2>@ViewBag.AvailableRooms</h2>
            <p>Available Rooms</p>
        </div>

        <div class="admin-card">
            <h2>@ViewBag.OccupiedRooms</h2>
            <p>Occupied Rooms</p>
        </div>

        <div class="admin-card">
            <h2>@ViewBag.TotalUsers</h2>
            <p>Registered Applicants</p>
        </div>

    </div>

    <div class="admin-management">

        <h2>Management</h2>

        <div class="management-grid">

            <a href="@Url.Action("ManageRooms","Admin")"
               class="management-card">

                <div class="management-icon">
                    🏠
                </div>

                <h3>Manage Rooms</h3>

                <p>
                    Add, edit and manage accommodation rooms.
                </p>

            </a>

            <a href="@Url.Action("Applications","Admin")"
               class="management-card">

                <div class="management-icon">
                    📋
                </div>

                <h3>Manage Applications</h3>

                <p>
                    Approve or reject student applications.
                </p>

            </a>

            <a href="@Url.Action("Payments","Admin")"
               class="management-card">

                <div class="management-icon">
                    💳
                </div>

                <h3>Payments</h3>

                <p>
                    View pending and processed payments.
                </p>

            </a>

            <a href="@Url.Action("Maintenance","Admin")"
               class="management-card">

                <div class="management-icon">
                    🔧
                </div>

                <h3>Maintenance Requests</h3>

                <p>
                    View and manage maintenance requests.
                </p>

            </a>

        </div>

    </div>

</div>