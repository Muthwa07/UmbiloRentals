@model IEnumerable<UmbiloRentals.Models.MaintenanceRequest>

@{
    ViewBag.Title = "Maintenance Requests";
}

<div class="application-page">

    <h1>Maintenance Requests</h1>

    <table class="table">

        <tr>
            <th>Room</th>
            <th>Tenant</th>
            <th>Issue</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Reported</th>
            <th>Actions</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>

                <td>Room @item.RoomID</td>

                <td>Tenant @item.TenantID</td>

                <td>
                    <strong>@item.Title</strong>
                    <br />
                    @item.Description
                </td>

                <td>
                    <span class="priority-badge priority-@item.Priority.ToLower()">
                        @item.Priority
                    </span>
                </td>

                <td>
                    <span class="status-badge status-@item.Status.Replace(" ","").ToLower()">
                        @item.Status
                    </span>
                </td>

                <td>
                    @item.DateReported
                </td>

                <td>

                    @if (item.Status == "Pending")
                    {
                        @Html.ActionLink(
                            "Start",
                            "StartMaintenance",
                            new { id = item.RequestID },
                            new { @class = "btn-room" }
                        )
                    }

                    else if (item.Status == "In Progress")
                    {
                        @Html.ActionLink(
                            "Complete",
                            "CompleteMaintenance",
                            new { id = item.RequestID },
                            new { @class = "btn-register" }
                        )
                    }

                </td>

            </tr>
        }

    </table>

</div>