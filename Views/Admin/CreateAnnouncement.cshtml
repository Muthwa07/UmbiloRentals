@{
    ViewBag.Title = "Post Announcement";
}

<style>
    .announcement-page {
        padding: 40px;
        background: #f5f6f8;
        min-height: 80vh;
    }

    .announcement-card {
        max-width: 650px;
        margin: auto;
        background: white;
        padding: 35px;
        border-radius: 12px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

        .announcement-card h1 {
            margin-bottom: 10px;
            color: #263238;
        }

        .announcement-card p {
            color: #777;
            margin-bottom: 25px;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
            color: #263238;
        }

    .form-control {
        width: 100%;
        padding: 11px;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-sizing: border-box;
        font-size: 14px;
    }

    textarea.form-control {
        min-height: 140px;
        resize: vertical;
    }

    .error-message {
        background: #f8d7da;
        color: #721c24;
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 20px;
    }

    .success-message {
        background: #d4edda;
        color: #155724;
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 20px;
    }

    .btn-post {
        padding: 12px 22px;
        border: none;
        border-radius: 6px;
        background: #263238;
        color: white;
        cursor: pointer;
        font-size: 15px;
    }

        .btn-post:hover {
            opacity: 0.9;
        }
</style>

<div class="announcement-page">

    <div class="announcement-card">

        <h1>Post Announcement</h1>

        <p>
            Send an announcement to tenants or staff members.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        @if (ViewBag.Success != null)
        {
            <div class="success-message">
                @ViewBag.Success
            </div>
        }

        @using (Html.BeginForm(
            "CreateAnnouncement",
            "Admin",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">

                <label>Announcement Title</label>

                <input type="text"
                       name="title"
                       class="form-control"
                       placeholder="Enter announcement title" />

            </div>

            <div class="form-group">

                <label>Message</label>

                <textarea name="message"
                          class="form-control"
                          placeholder="Enter announcement message"></textarea>

            </div>

            <div class="form-group">

                <label>Send To</label>

                <select name="targetRole"
                        class="form-control">

                    <option value="">Select who should receive this</option>

                    <option value="Tenant">
                        All Tenants
                    </option>

                    <option value="Maintenance">
                        All Maintenance Staff
                    </option>

                    <option value="Security">
                        All Security Staff
                    </option>

                </select>

            </div>

            <button type="submit" class="btn-post">
                Post Announcement
            </button>

        }

    </div>

</div> 