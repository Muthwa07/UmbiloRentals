@model IEnumerable<UmbiloRentals.Models.Payment>

@{
    ViewBag.Title = "Payments";
}

<div class="application-page">

    <h1>Payments</h1>

    <div class="dashboard-cards">

        <div class="dashboard-card">

            <h2>@ViewBag.Pending</h2>

            <p>Pending</p>

        </div>

        <div class="dashboard-card">

            <h2>@ViewBag.Processed</h2>

            <p>Processed</p>

        </div>

    </div>

    <table class="table">

        <tr>

            <th>User</th>
            <th>Room</th>
            <th>Month</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Proof</th>
            <th>Action</th>

        </tr>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.UserID</td>

                <td>@item.RoomID</td>

                <td>@item.PaymentMonth</td>

                <td>R @item.Amount</td>

                <td>
                    <span class="status-badge status-@item.Status.ToLower()">
                        @item.Status
                    </span>
                </td>

                <td>

                    @if (!string.IsNullOrEmpty(item.ProofOfPayment))
                    {
                        <a href="@Url.Content(item.ProofOfPayment)"
                           target="_blank">
                            View
                        </a>
                    }

                </td>

                <td>

                    @if (item.Status == "Pending")
                    {
                        @Html.ActionLink(
                        "Verify",
                        "VerifyPayment",
                        new { id = item.PaymentID },
                        new { @class = "btn-register" })
                    }

                </td>

            </tr>
        }

    </table>

</div>