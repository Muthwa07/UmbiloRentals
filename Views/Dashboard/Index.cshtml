@{
    ViewBag.Title = "Dashboard";
}

<div class="dashboard-page">

    <div class="dashboard-header">

        <h1>Welcome, @ViewBag.FirstName</h1>

    
        <p>
            Here's a quick overview of your accommodation and application progress.
        </p>

    </div>


    <div class="dashboard-cards">
        <div class="dashboard-card">

            <h2>@ViewBag.ApprovedApplications</h2>

            <p>Approved Applications</p>

            @Html.ActionLink(
                "View Status",
                "Index",
                "Applications",
                null,
                new { @class = "dashboard-button" }
            )

        </div>


        <div class="dashboard-card">

            <h2>@ViewBag.TotalApplications</h2>

            <p>My Applications</p>

            @Html.ActionLink(
                "View Applications",
                "Index",
                "Applications",
                null,
                new { @class = "dashboard-button" }
            )

        </div>


        <div class="dashboard-card">

            <h2>@ViewBag.PendingApplications</h2>

            <p>Pending Applications</p>

            @Html.ActionLink(
                "Check Status",
                "Index",
                "Applications",
                null,
                new { @class = "dashboard-button" }
            )

        </div>

        <div class="dashboard-card">

            <h2>🔧</h2>

            <p>Maintenance Requests</p>

            @Html.ActionLink(
                "View Requests",
                "MyRequests",
                "Maintenance",
                null,
                new { @class = "dashboard-button" }
            )

        </div>

        <div class="dashboard-card">

            <h2>💳</h2>

            <p>Payments</p>

            @Html.ActionLink(
            "View Payments",
            "Index",
            "Payments",
            null,
            new { @class = "dashboard-button" })

        </div>

    </div>


    <div class="dashboard-actions">

        <h2>What would you like to do?</h2>

        <div class="dashboard-action-buttons">

            @Html.ActionLink(
                "Browse Available Rooms",
                "Index",
                "Rooms",
                null,
                new { @class = "btn-register" }
            )

            @Html.ActionLink(
                "My Applications",
                "Index",
                "Applications",
                null,
                new { @class = "btn-room" }
            )


            @Html.ActionLink(
    "Report Maintenance",
    "Create",
    "Maintenance",
    null,
    new { @class = "btn-register" }
)

        </div>

    </div>

</div>