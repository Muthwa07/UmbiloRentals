@model IEnumerable<UmbiloRentals.Models.Room>

@{
    ViewBag.Title = "Rooms";
}

<div class="rooms-page">

    <div class="rooms-header">

        <h1>Available Accommodation</h1>

        <p>
            Browse secure, affordable student rooms designed for comfortable living.
        </p>

    </div>

    <div class="room-grid">

        @foreach (var room in Model)
        {
            <div class="room-card">

                <div class="room-image">

                    @if (!string.IsNullOrEmpty(room.Photo))
                    {
                        <img src="@Url.Content("~/Content/RoomImages/" + room.Photo)"
                             alt="Room @room.RoomNumber" />
                    }
                    else
                    {
                        <AsyncImage query="modern student accommodation bedroom South Africa" aspectRatio="4:3" width="100%" maxHeight=240 />
                    }

                    <div class="room-status @(room.Status == "Available" ? "status-available" : "status-occupied")">
                        @room.Status
                    </div>

                </div>

                <div class="room-body">

                    <div class="room-title">

                        <h3>Room @room.RoomNumber</h3>

                        <span class="rent-chip">
                            R @room.MonthlyRent / month
                        </span>

                    </div>

                    <p class="room-description">
                        @room.Description
                    </p>

                    <div class="room-features">

                        <div class="feature-item">
                            <icon name=wifi />
                            Wi-Fi
                        </div>

                        <div class="feature-item">
                            <icon name=car />
                            Parking
                        </div>

                        <div class="feature-item">
                            <icon name=utensils />
                            Kitchen
                        </div>

                        <div class="feature-item">
                            <icon name=shield-check />
                            Secure
                        </div>

                    </div>

                    <div class="room-footer">

                        @Html.ActionLink(
                            "View Details",
                            "Details",
                            new { id = room.RoomID },
                            new { @class = "btn-room-primary" })

                        @if (room.Status == "Available")
                        {
                            @Html.ActionLink(
                                "Apply",
                                "Create",
                                "Applications",
                                new { roomId = room.RoomID },
                                new { @class = "btn-room-secondary" })
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>