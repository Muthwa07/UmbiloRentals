@model UmbiloRentals.Models.Room

@{
    ViewBag.Title = "Room Details";
}

<div class="room-details-page">

    <!-- HERO IMAGE -->

    <div class="room-hero">

        @if (!string.IsNullOrEmpty(Model.Photo))
        {
            <img src="@Url.Content("~/Content/RoomImages/" + Model.Photo)"
                 alt="Room @Model.RoomNumber" />
        }
        else
        {
            <AsyncImage query="modern luxury student accommodation bedroom South Africa" aspectRatio="16:9" width="100%" maxHeight=500 />
        }

    </div>

    <div class="room-layout">

        <!-- LEFT -->

        <div class="room-info">

            <div class="room-header">

                <h1>Room @Model.RoomNumber</h1>

                <span class="status-pill @(Model.Status == "Available" ? "status-available" : "status-occupied")">
                    @Model.Status
                </span>
            </div>

            <hr />

            <div class="room-features">

                <h3>Room Features</h3>

                <div class="feature-grid">

                    <div class="feature-item">
                        <icon name=bath color=info /> Shared Bathroom
                    </div>

                    <div class="feature-item">
                        <icon name=cooking-pot color=info /> Shared Kitchen
                    </div>

                    <div class="feature-item">
                        <icon name=wifi color=info /> Free Wi-Fi
                    </div>

                    <div class="feature-item">
                        <icon name=droplet color=info /> Water Included
                    </div>

                    <div class="feature-item">
                        <icon name=bolt color=info /> Electricity Included
                    </div>

                    <div class="feature-item">
                        <icon name=shield-check color=info /> 24/7 Security
                    </div>

                    <div class="feature-item">
                        <icon name=shirt color=info /> Laundry Area
                    </div>

                    <div class="feature-item">
                        <icon name=car color=info /> Parking Available
                    </div>

                </div>

            </div>

            <hr />

            <div class="room-gallery">

                <h3>Room Gallery</h3>

                <div class="gallery-grid">

                    <div class="gallery-item">
                        <img src="@Url.Content(Model.Photo)"
                             alt="Room @Model.RoomNumber" />
                        <p>Bedroom</p>
                    </div>

                    <div class="gallery-item">
                        <img src="@Url.Content("~/Content/RoomImages/Bathroom.jpg")"
                             alt="Bathroom" />
                        <p>Shared Bathroom</p>
                    </div>

                    <div class="gallery-item">
                        <img src="@Url.Content("~/Content/RoomImages/Kitchen.jpg")"
                             alt="Kitchen" />
                        <p>Shared Kitchen</p>
                    </div>

                </div>

            </div>

            <div class="price-card">

                <h2>R @Model.MonthlyRent</h2>

                <p>per month</p>

            </div>

            <h3>Description</h3>

            <p>@Model.Description</p>

            <h3>Amenities</h3>

            <div class="amenities">

                <div class="amenity">
                    <icon name=wifi color=info />
                    Wi-Fi
                </div>

                <div class="amenity">
                    <icon name=utensils color=info />
                    Shared Kitchen
                </div>

                <div class="amenity">
                    <icon name=car color=info />
                    Parking
                </div>

                <div class="amenity">
                    <icon name=shield-check color=info />
                    Secure Access
                </div>

                <div class="amenity">
                    <icon name=droplet color=info />
                    Water Included
                </div>

                <div class="amenity">
                    <icon name=zap color=info />
                    Electricity Available
                </div>

            </div>

        </div>

        <!-- RIGHT -->

        <div class="booking-card">

            <h3>Room Summary</h3>

            <ul class="booking-list">

                <li><strong>Room:</strong> @Model.RoomNumber</li>

                <li><strong>Rent:</strong> R @Model.MonthlyRent</li>

                <li><strong>Status:</strong> @Model.Status</li>

                <li><strong>Secure Accommodation</strong></li>

                <li><strong>Online Applications</strong></li>

            </ul>

            @if (Model.Status == "Available")
            {
                if (!(bool)ViewBag.IsLoggedIn)
                {
                    @Html.ActionLink(
                        "Login to Apply",
                        "Login",
                        "Account",
                        null,
                        new { @class = "btn-login-apply" })
                }
                else if ((bool)ViewBag.HasApplied)
                {
                    <button class="btn-applied" disabled>
                        ✓ Application Submitted
                    </button>
                }
                else
                {
                    @Html.ActionLink(
                        "Apply Now",
                        "Create",
                        "Applications",
                        new { roomId = Model.RoomID },
                        new { @class = "btn-apply" })
                }
            }
            else
            {
                <button class="btn-occupied" disabled>
                    Currently Occupied
                </button>
            }

            @Html.ActionLink(
                "Back to Rooms",
                "Index",
                "Rooms",
                null,
                new { @class = "btn-back" })

        </div>

    </div>

</div>