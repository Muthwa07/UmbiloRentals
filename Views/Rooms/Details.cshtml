@model UmbiloRentals.Models.Room

@{
    ViewBag.Title = "Room " + Model.RoomNumber;
}

<div class="room-details-page">

    <!-- HERO IMAGE -->

    <div class="room-hero">

        @if (!string.IsNullOrEmpty(Model.Photo))
        {
            <img src="@Url.Content("~/Content/RoomImages/" + Model.Photo)"
                 alt="Room @Model.RoomNumber" />
        }
        else
        {
            <div class="no-photo-placeholder">
                <i class="bi bi-house-door"></i>
                <span>No photo available</span>
            </div>
        }

    </div>

    <div class="room-layout">

        <!-- MAIN CONTENT -->

        <div class="room-info">

            <div class="room-header">

                <div>
                    <h1>Room @Model.RoomNumber</h1>
                    <span class="room-status-pill @(Model.Status == "Available" ? "status-available" : "status-occupied")">
                        @Model.Status
                    </span>
                </div>

                <div class="room-price">
                    <strong>R @Model.MonthlyRent</strong>
                    <span>/ month</span>
                </div>

            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <section class="room-section">
                    <h2>About this room</h2>
                    <p>@Model.Description</p>
                </section>
            }

            <section class="room-section">

                <h2>Features</h2>

                <p class="room-features-note">
                    General building features. Confirm specifics with the accommodation team before applying.
                </p>

                <div class="amenities">

                    <div class="amenity"><i class="bi bi-wifi icon-info"></i> Wi-Fi</div>
                    <div class="amenity"><i class="bi bi-droplet-half icon-info"></i> Shared Bathroom</div>
                    <div class="amenity"><i class="bi bi-cup-hot-fill icon-info"></i> Shared Kitchen</div>
                    <div class="amenity"><i class="bi bi-lightning-charge-fill icon-info"></i> Electricity Included</div>
                    <div class="amenity"><i class="bi bi-droplet-fill icon-info"></i> Water Included</div>
                    <div class="amenity"><i class="bi bi-shield-check icon-info"></i> 24/7 Security</div>
                    <div class="amenity"><i class="bi bi-car-front-fill icon-info"></i> Parking Available</div>

                </div>

            </section>

            <section class="room-section reviews-section">

                <div class="reviews-header">

                    <h2>Reviews</h2>

                    @if (ViewBag.AverageRating != null)
                    {
                        <span class="average-rating">
                            <i class="bi bi-star-fill icon-warning"></i>
                            @ViewBag.AverageRating
                            <span class="review-count">(@ViewBag.ReviewCount review@(ViewBag.ReviewCount == 1 ? "" : "s"))</span>
                        </span>
                    }

                </div>

                @if (ViewBag.ReviewCount == 0)
                {
                    <p class="no-reviews">
                        No reviews yet - be the first to leave one after your stay.
                    </p>
                }
                else
                {
                    foreach (var review in ViewBag.Reviews)
                    {
                        <div class="review-item">

                            <div class="review-item-header">

                                <span class="review-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </span>

                                <span class="review-date">
                                    @review.DatePosted.ToString("MMMM yyyy")
                                </span>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="review-comment">@review.Comment</p>
                            }

                        </div>
                    }
                }

            </section>

        </div>

        <!-- STICKY CTA SIDEBAR -->

        <div class="room-cta-card">

            @if (Model.Status == "Available")
            {
                if (!ViewBag.IsLoggedIn)
                {
                    @Html.ActionLink("Login to Apply", "Login", "Account", null, new { @class = "btn-apply" })
                }
                else if (ViewBag.HasApplied)
                {
                    <button class="btn-apply" disabled>
                        <i class="bi bi-check-circle-fill"></i> Application Submitted
                    </button>
                }
                else
                {
                    @Html.ActionLink("Apply Now", "Create", "Applications", new { roomId = Model.RoomID }, new { @class = "btn-apply" })
                }
            }
            else
            {
                <button class="btn-occupied" disabled>Currently Occupied</button>
            }

            @Html.ActionLink("Back to Rooms", "Index", "Rooms", null, new { @class = "btn-back" })

        </div>

    </div>

</div>
