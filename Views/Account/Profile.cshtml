@model UmbiloRentals.Models.User

@{
    ViewBag.Title = "My Profile";
}

<div class="account-page">

    <div class="account-card">

        <div class="account-header">
            <h1>My Profile</h1>
            <p>Keep your account information up to date.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @using (Html.BeginForm("Profile", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.UserID)

            <div class="profile-avatar">
                <div class="profile-circle">
                    @(Model.FirstName.Substring(0,1))@(Model.LastName.Substring(0,1))
                </div>
            </div>

            <div class="form-group">
                <label>First Name</label>
                @Html.TextBoxFor(m => m.FirstName,
                    new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Last Name</label>
                @Html.TextBoxFor(m => m.LastName,
                    new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Email</label>
                @Html.TextBoxFor(m => m.Email,
                    new { @class = "form-control", type = "email" })
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                @Html.TextBoxFor(m => m.Phone,
                    new { @class = "form-control" })
            </div>

            <button type="submit" class="btn-register">
                Save Changes
            </button>
        }

    </div>

</div>