@model UmbiloRentals.Models.User

@{
    ViewBag.Title = "My Profile";
}

<div class="profile-page">

    <div class="profile-hero">

        <div class="profile-avatar">
            @(Model.FirstName != null ? Model.FirstName.Substring(0,1).ToUpper() : "U")
        </div>

        <div>

            <h1>@Model.FirstName @Model.LastName</h1>

            <p>Manage your Umbilo Rentals account</p>

            <div class="profile-badges">

                <span class="status-badge active">
                    Active Account
                </span>

                <span class="member-badge">
                    Member since @Model.DateCreated.Value.ToString("MMM yyyy")
                </span>

            </div>

        </div>

    </div>



    @using (Html.BeginForm("Profile", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="profile-grid">

            <div class="glass-card">

                <h2>Personal Information</h2>

                <div class="form-group">
                    <label>First Name</label>
                    @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    <label>Last Name</label>
                    @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    <label>Email</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                </div>

                <div class="form-group">
                    <label>Phone</label>
                    @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    <label>Occupation</label>
                    @Html.TextBoxFor(m => m.Occupation, new { @class = "form-control", placeholder = "Student, Teacher, Engineer..." })
                </div>

            </div>

            <div class="glass-card">

                <h2>Emergency Contact</h2>

                <div class="form-group">
                    <label>Contact Name</label>
                    @Html.TextBoxFor(m => m.EmergencyContactName, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    <label>Contact Phone</label>
                    @Html.TextBoxFor(m => m.EmergencyContactPhone, new { @class = "form-control" })
                </div>

                <div class="account-info">

                    <h3>Account Information</h3>

                    <p><strong>Status:</strong> @Model.Status</p>

                    <p><strong>Joined:</strong> @Model.DateCreated.Value.ToString("dd MMM yyyy")</p>

                </div>

            </div>

        </div>

        <div class="glass-card compatibility-card">

            <h2>Roommate Compatibility</h2>

            <p class="compatibility-intro">
                This helps us (and future roommates) understand your living
                preferences. All fields are optional.
            </p>

            <div class="profile-grid">

                <div class="form-group">
                    <label for="SleepSchedule">Sleep Schedule</label>
                    @Html.DropDownListFor(
                        m => m.SleepSchedule,
                        new SelectList(
                            new[] { "Early Bird", "Night Owl", "Flexible" },
                            Model.SleepSchedule),
                        "Prefer not to say",
                        new { @class = "form-control", id = "SleepSchedule" })
                </div>

                <div class="form-group">
                    <label for="CleanlinessLevel">Cleanliness</label>
                    @Html.DropDownListFor(
                        m => m.CleanlinessLevel,
                        new SelectList(
                            new[] { "Very Tidy", "Average", "Relaxed" },
                            Model.CleanlinessLevel),
                        "Prefer not to say",
                        new { @class = "form-control", id = "CleanlinessLevel" })
                </div>

                <div class="form-group">
                    <label for="NoiseTolerance">Noise Preference</label>
                    @Html.DropDownListFor(
                        m => m.NoiseTolerance,
                        new SelectList(
                            new[] { "Quiet", "Moderate", "Social" },
                            Model.NoiseTolerance),
                        "Prefer not to say",
                        new { @class = "form-control", id = "NoiseTolerance" })
                </div>

                <div class="form-group">
                    <label for="StudyHabit">Study Habits</label>
                    @Html.DropDownListFor(
                        m => m.StudyHabit,
                        new SelectList(
                            new[] { "Studies at Home", "Studies Elsewhere" },
                            Model.StudyHabit),
                        "Prefer not to say",
                        new { @class = "form-control", id = "StudyHabit" })
                </div>

                <div class="form-group">
                    <label for="GuestsPreference">Having Guests Over</label>
                    @Html.DropDownListFor(
                        m => m.GuestsPreference,
                        new SelectList(
                            new[] { "Rarely", "Sometimes", "Often" },
                            Model.GuestsPreference),
                        "Prefer not to say",
                        new { @class = "form-control", id = "GuestsPreference" })
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox"
                               name="IsSmoker"
                               value="true"
                               @(Model.IsSmoker == true ? Html.Raw("checked") : Html.Raw("")) />
                        Smoker
                    </label>
                </div>

            </div>

        </div>

        <div class="save-section">

            <button class="btn-save-profile" type="submit">
                Save Changes
            </button>

        </div>
    }

</div>