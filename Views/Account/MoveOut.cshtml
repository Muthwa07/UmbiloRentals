@{
    ViewBag.Title = "Move Out";
}

<div class="moveout-page">

    <div class="moveout-card">

        <div class="moveout-icon">

            <i class="bi bi-door-open-fill icon-warning icon-2xl"></i>

        </div>

        <h1>Move Out</h1>

        <p>
            You're about to end your tenancy for
            <strong>Room @ViewBag.RoomNumber</strong>.
        </p>

        <div class="moveout-warning">

            <i class="bi bi-exclamation-triangle-fill icon-warning"></i>

            <div>

                <strong>Before you continue</strong>

                <p>
                    Your room will become available for new applicants,
                    and your tenancy will be marked as completed.
                </p>

            </div>

        </div>

        @using (Html.BeginForm("MoveOut", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="moveout-actions">

                <button type="submit"
                        class="btn-danger-glass">
                    Confirm Move Out
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Dashboard",
                    "Account",
                    null,
                    new { @class = "btn-secondary-glass" })

            </div>
        }

    </div>

</div>