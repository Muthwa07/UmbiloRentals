@{
    ViewBag.Title = "Reset Password";
}

<div class="account-page">

    <div class="account-card">

        <div class="account-header">

            <i class="bi bi-shield-check icon-success icon-2xl"></i>

            <h1>Enter Your Code</h1>

            <p>
                We sent a 6-digit code to <strong>@ViewBag.Email</strong>.
                It expires 2 minutes after being sent, so enter it quickly.
            </p>

        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <input type="hidden" name="email" value="@ViewBag.Email" />

            <div class="form-group">

                <label>6-Digit Code</label>

                <input type="text"
                       name="code"
                       id="code"
                       class="form-control"
                       placeholder="000000"
                       inputmode="numeric"
                       pattern="[0-9]{6}"
                       maxlength="6"
                       autocomplete="one-time-code"
                       required />

            </div>

            <div class="form-group">

                <label>New Password</label>

                <input type="password"
                       name="password"
                       id="password"
                       class="form-control"
                       placeholder="Enter a new password"
                       minlength="6"
                       required />

            </div>

            <div class="form-group">

                <label>Confirm New Password</label>

                <input type="password"
                       name="confirmPassword"
                       id="confirmPassword"
                       class="form-control"
                       placeholder="Re-enter your new password"
                       required />

                <p id="passwordMessage" style="margin-top:6px;font-size:13px;"></p>

            </div>

            <button type="submit" class="btn-auth">

                <i class="bi bi-lock-fill"></i>
                Reset Password

            </button>
        }

        <div class="auth-links">

            @Html.ActionLink("Request a new code", "ForgotPassword", "Account")

        </div>

    </div>

</div>

@section scripts {
    <script>
        (function () {
            const password = document.getElementById("password");
            const confirmPassword = document.getElementById("confirmPassword");
            const msg = document.getElementById("passwordMessage");

            if (!password || !confirmPassword || !msg) { return; }

            function checkMatch() {
                if (confirmPassword.value === "") {
                    msg.innerHTML = "";
                    return;
                }

                if (confirmPassword.value === password.value) {
                    msg.innerHTML = "Passwords match";
                    msg.style.color = "#16A34A";
                } else {
                    msg.innerHTML = "Passwords do not match";
                    msg.style.color = "#DC2626";
                }
            }

            confirmPassword.addEventListener("keyup", checkMatch);
            password.addEventListener("keyup", checkMatch);
        })();
    </script>
}
