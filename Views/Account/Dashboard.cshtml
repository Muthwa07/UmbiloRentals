@{
    ViewBag.Title = "Dashboard";

    bool isTenant = ViewBag.IsTenant;
    bool hasApplication = ViewBag.HasApplication ?? false;
    string latestStatus = ViewBag.LatestApplicationStatus;
}

<div class="dashboard-page">

    <!-- HERO -->

    <div class="dashboard-hero">

        <div class="hero-content">

            <h1>Welcome back, @Session["UserName"]</h1>

            <p>
                Track your accommodation journey, payments and applications from one place.
            </p>

        </div>

    </div>

    @if (isTenant)
    {
        <!-- ======= TENANT: RESIDENCE CARD ======= -->

        <div class="tenant-residence-card glass-card">

            <div class="tenant-header">

                <div>

                    <h2><i class="bi bi-house-door-fill"></i> Current Residence</h2>

                    <p>Your accommodation has been allocated.</p>

                </div>

                <span class="tenant-status">
                    Active Tenant
                </span>

            </div>

            <div class="tenant-grid">

                <div class="tenant-item">
                    <span>Room</span>
                    <strong>@ViewBag.CurrentRoom</strong>
                </div>

                <div class="tenant-item">
                    <span>Monthly Rent</span>
                    <strong>R @ViewBag.CurrentRent</strong>
                </div>

                <div class="tenant-item">
                    <span>Status</span>
                    <strong>@ViewBag.RoomStatus</strong>
                </div>

                <div class="tenant-item">
                    <span>Allocated</span>
                    <strong>@(((DateTime?)ViewBag.MoveInDate)?.ToString("dd MMM yyyy"))</strong>
                </div>

            </div>

            <div class="rent-status-row">

                @if (ViewBag.RentPaidThisMonth)
                {
                    <span class="status-chip approved">
                        <i class="bi bi-check-circle-fill"></i>
                        Rent paid for @DateTime.Now.ToString("MMMM")
                    </span>
                }
                else if (ViewBag.RentPendingThisMonth)
                {
                    <span class="status-chip pending">
                        <i class="bi bi-hourglass-split"></i>
                        Payment for @DateTime.Now.ToString("MMMM") awaiting confirmation
                    </span>
                }
                else
                {
                    <span class="status-chip rejected">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        Rent not yet paid for @DateTime.Now.ToString("MMMM")
                    </span>
                }

            </div>

            <div class="tenant-actions">

                @if (!(bool)ViewBag.RentPaidThisMonth)
                {
                    @Html.ActionLink(
                        "Pay This Month's Rent",
                        "PayNow",
                        "Payments",
                        new { applicationId = ViewBag.ApprovedApplicationID },
                        new { @class = "btn-room-primary" })
                }

                @Html.ActionLink(
                    "Report Maintenance",
                    "Report",
                    "Maintenance",
                    null,
                    new { @class = "btn-secondary-glass" })

                @Html.ActionLink(
                    "Move Out",
                    "MoveOut",
                    "Account",
                    null,
                    new { @class = "btn-secondary-glass" })

            </div>

        </div>
    }
    else
    {
        <!-- ======= APPLICANT: STAT CARDS ======= -->

        <div class="dashboard-card-grid">

            <a href="@Url.Action("Index","Rooms")" class="dashboard-card glass-card dashboard-card-link">
                <i class="bi bi-house-door-fill icon-info icon-2xl"></i>
                <h3>@ViewBag.AvailableRooms Available Rooms</h3>
                <p>Browse accommodation.</p>
            </a>

            <a href="@Url.Action("Index","Applications")" class="dashboard-card glass-card dashboard-card-link">
                <i class="bi bi-file-earmark-text-fill icon-info icon-2xl"></i>
                <h3>@ViewBag.TotalApplications Application@(ViewBag.TotalApplications == 1 ? "" : "s")</h3>
                <p>@ViewBag.PendingApplications pending review.</p>
            </a>

        </div>
    }

    <!-- ======= YOUR STATUS (consolidated) ======= -->

    <div class="glass-panel">

        <h2>Your Status</h2>

        @if (isTenant)
        {
            <div class="status-summary-row">
                <div class="status-summary-item complete">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Application Approved</span>
                </div>
                <div class="status-summary-item complete">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Room Allocated</span>
                </div>
                <div class="status-summary-item @(ViewBag.RentPaidThisMonth ? "complete" : "current")">
                    <i class="bi @(ViewBag.RentPaidThisMonth ? "bi-check-circle-fill" : "bi-hourglass-split")"></i>
                    <span>Rent Payment</span>
                </div>
                <div class="status-summary-item complete">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Moved In</span>
                </div>
            </div>
        }
        else if (hasApplication)
        {
            <div class="status-summary-row">
                <div class="status-summary-item complete">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Application Submitted</span>
                </div>
                <div class="status-summary-item @(latestStatus == "Pending" ? "current" : "complete")">
                    <i class="bi @(latestStatus == "Pending" ? "bi-hourglass-split" : "bi-check-circle-fill")"></i>
                    <span>Under Review</span>
                </div>
                <div class="status-summary-item @(latestStatus == "Approved" ? "complete" : latestStatus == "Rejected" ? "rejected" : latestStatus == "Withdrawn" ? "withdrawn" : "")">
                    <i class="bi @(latestStatus == "Approved" ? "bi-check-circle-fill" : latestStatus == "Rejected" ? "bi-x-circle-fill" : latestStatus == "Withdrawn" ? "bi-arrow-return-left" : "bi-circle")"></i>
                    <span>@(latestStatus == "Withdrawn" ? "Withdrawn" : latestStatus == "Rejected" ? "Rejected" : "Decision")</span>
                </div>
            </div>

            <p class="status-panel-note">
                @Html.ActionLink("View all your applications", "Index", "Applications")
            </p>
        }
        else
        {
            <p>You haven't applied for a room yet.</p>

            @Html.ActionLink(
                "Browse Rooms",
                "Index",
                "Rooms",
                null,
                new { @class = "btn-room-primary" })
        }

    </div>

    <!-- ======= SUPPORT ======= -->

    <div class="glass-panel">

        <h2>Need Help?</h2>

        <p>
            If you're experiencing issues with your application,
            payments or room allocation, our support team is ready to assist.
        </p>

        @Html.ActionLink(
            "Contact Us",
            "Contact",
            "Home",
            null,
            new { @class = "btn-room-primary" })

    </div>

</div>
