@model IEnumerable<UmbiloRentals.Models.Complaint>

@{
    ViewBag.Title = "My Reported Issues";
}

<div class="admin-review-page">

    <div class="page-header">

        <div>
            <h1>My Reported Issues</h1>
            <p>Issues you've reported to security.</p>
        </div>

        @Html.ActionLink("Report an Issue", "ReportComplaint", null, new { @class = "btn-room-primary" })

    </div>

    @if (!Model.Any())
    {
        <div class="empty-state glass-card">
            <i class="bi bi-shield-check icon-info icon-2xl"></i>
            <h2>Nothing reported</h2>
            <p>Any issues you report to security will show up here.</p>
        </div>
    }
    else
    {
        <div class="review-grid">

            @foreach (var item in Model)
            {
                <div class="review-card glass-card">

                    <div class="review-body">

                        <div class="review-top">

                            <div>
                                <h3>@item.ComplaintType</h3>
                                <p>
                                    <i class="bi bi-calendar-event-fill icon-info"></i>
                                    @(item.DateSubmitted.HasValue ? item.DateSubmitted.Value.ToString("dd MMM yyyy") : "-")
                                </p>
                            </div>

                            <span class="status-chip @(item.Status ?? "").ToLower()">
                                @item.Status
                            </span>

                        </div>

                        <p class="room-description">@item.Description</p>

                    </div>

                </div>
            }

        </div>
    }

</div>
