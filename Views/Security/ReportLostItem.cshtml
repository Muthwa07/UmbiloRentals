@{
    ViewBag.Title = "Report a Lost Item";
}

<div class="legal-page">

    <div class="legal-header">
        <h1>Report a Lost Item</h1>
        <p class="legal-updated">We'll let you know if it turns up.</p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="glass-alert error">
            <i class="bi bi-x-circle-fill icon-danger"></i>
            <div>
                <strong>Something went wrong</strong>
                <p>@ViewBag.ErrorMessage</p>
            </div>
        </div>
    }

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="glass-card">

            <div class="form-group">
                <label for="itemName">What did you lose?</label>
                <input type="text" id="itemName" name="itemName" class="form-control" placeholder="e.g. Black wallet, blue umbrella" required />
            </div>

            <div class="form-group">
                <label for="description">Description (optional)</label>
                <textarea id="description" name="description" class="form-control" rows="4" placeholder="Any details that'll help identify it, and where you think you lost it"></textarea>
            </div>

            <button type="submit" class="btn-auth">
                Submit Report <i class="bi bi-arrow-right"></i>
            </button>

        </div>
    }

</div>
