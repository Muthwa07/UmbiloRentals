@{
    ViewBag.Title = "Log a Found Item";
}

<div class="legal-page">

    <div class="legal-header">
        <h1>Log a Found Item</h1>
        <p class="legal-updated">Record something found on the property so tenants can claim it.</p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="glass-alert error">
            <i class="bi bi-x-circle-fill icon-danger"></i>
            <div>
                <strong>Something went wrong</strong>
                <p>@ViewBag.ErrorMessage</p>
            </div>
        </div>
    }

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="glass-card">

            <div class="form-group">
                <label for="itemName">Item</label>
                <input type="text" id="itemName" name="itemName" class="form-control" placeholder="e.g. Black wallet, blue umbrella" required />
            </div>

            <div class="form-group">
                <label for="description">Description / where found</label>
                <textarea id="description" name="description" class="form-control" rows="4" placeholder="Any details that'll help the owner recognise it, and where you found it"></textarea>
            </div>

            <button type="submit" class="btn-auth">
                Log Item <i class="bi bi-arrow-right"></i>
            </button>

        </div>
    }

</div>
