@{
    ViewBag.Title = "Tenant Dashboard";
}

<style>
    .dashboard {
        padding: 40px;
        background: #f5f6f8;
        min-height: 80vh;
    }

    .dashboard-header {
        background: #263238;
        color: white;
        padding: 30px;
        border-radius: 12px;
        margin-bottom: 30px;
    }

        .dashboard-header h1 {
            margin: 0 0 8px 0;
            font-size: 30px;
        }

        .dashboard-header p {
            margin: 0;
            opacity: 0.9;
        }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .dashboard-card {
        background: white;
        padding: 25px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

        .dashboard-card .icon {
            font-size: 35px;
            margin-bottom: 12px;
        }

        .dashboard-card h3 {
            margin: 5px 0;
            color: #263238;
        }

        .dashboard-card p {
            color: #777;
            font-size: 14px;
        }
</style>

<div class="dashboard">

    <div class="dashboard-header">
        <h1>Tenant Dashboard</h1>

        <p>
            Welcome back, @Session["UserName"].
        </p>
    </div>

    <div class="dashboard-grid">

        <div class="dashboard-card">


            <h3>
                @Html.ActionLink(
                         "My Room",
                         "MyRoom",
                         "Tenant")
            </h3>

            <p>View your allocated room.</p>

        </div>
        <div class="dashboard-card">



            <h3>
                @Html.ActionLink(
                         "My profile",
                         "profile",
                         "Tenant"
                     )
            </h3>

            <p>View and edit your personal information.</p>

        </div>

        <div class="dashboard-card">

            <h3>Payments</h3>
            <p>Upload and view your proof of payment.</p>
        </div>

        <div class="dashboard-card">

            <h3>Maintenance</h3>
            <p>Report and track maintenance requests.</p>
        </div>

        <div class="dashboard-card">

            <h3>Visitors</h3>
            <p>Request and manage visitors.</p>
        </div>

        <div class="dashboard-card">

            <h3>
                @Html.ActionLink(
                         "Announcements",
                         "Announcements",
                         "Tenant"
                     )
            </h3>

            <p>View building announcements.</p>

        </div>


        <div class="dashboard-card">

            <h3>Complaints</h3>
            <p>Submit and track complaints.</p>
        </div>

    </div>

</div>

