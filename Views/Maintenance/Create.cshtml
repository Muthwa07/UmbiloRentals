@{
    ViewBag.Title = "Report Maintenance";
}

<div class="account-page">

    <div class="account-card">

        <div class="account-header">

            <h1>Report Maintenance</h1>

            <p>
                Tell us what's wrong with your room.
            </p>

        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-group">

                <label>Room</label>

                <input type="text"
                       class="form-control"
                       value="Room @ViewBag.RoomID"
                       readonly />

            </div>

            <div class="form-group">

                <label>Issue Title</label>

                <input type="text"
                       name="title"
                       class="form-control"
                       placeholder="Broken Light"
                       required />

            </div>

            <div class="form-group">

                <label>Description</label>

                <textarea name="description"
                          class="form-control"
                          rows="5"
                          placeholder="Describe the issue..."
                          required></textarea>

            </div>

            <div class="form-group">

                <label>Priority</label>

                <select name="priority"
                        class="form-control">

                    <option>Low</option>
                    <option selected>Medium</option>
                    <option>High</option>

                </select>

            </div>

            <button class="btn-register"
                    type="submit">

                Submit Request

            </button>
        }

    </div>

</div>