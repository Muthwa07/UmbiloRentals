@model IEnumerable<UmbiloRentals.Models.MaintenanceRequest>

@{
    ViewBag.Title = "My Maintenance Requests";
}

<div class="application-page">

    <h1>My Maintenance Requests</h1>

    <table class="table">

        <tr>
            <th>Room</th>
            <th>Issue</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Reported</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.RoomID</td>

                <td>
                    <strong>@item.Title</strong>
                    <br />
                    @item.Description
                </td>

                <td>
                    <span class="priority-badge priority-@item.Priority.ToLower()">
                        @item.Priority
                    </span>
                </td>

                <td>
                    <span class="status-badge status-@item.Status.Replace(" ","").ToLower()">
                        @item.Status
                    </span>
                </td>

                <td>@item.DateReported</td>

            </tr>
        }

    </table>

</div>