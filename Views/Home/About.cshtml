@{
    ViewBag.Title = "About";
}

<!-- HERO -->

<section class="about-hero">

    <div class="about-bg">
        <div class="about-bg-placeholder">
            <i class="bi bi-buildings"></i>
        </div>
    </div>

    <div class="about-card">

        <h1>About Umbilo Rentals</h1>

        <p>
            We're creating a simpler, safer and more modern way for students
            to find accommodation.
        </p>

    </div>

</section>

<!-- STORY -->

<section class="about-section">

    <div class="container story">

        <div>

            <h2>Our Story</h2>

            <p>
                Finding student accommodation shouldn't be stressful.
            </p>

            <p>
                Umbilo Rentals was designed to give students a secure online platform where they can browse rooms, submit applications, upload documents, make payments and request maintenance—all from one dashboard.
            </p>

            <p>
                We combine convenience with transparency to simplify the entire accommodation journey.
            </p>

        </div>

        <div>
            <div class="about-bg-placeholder about-story-image">
                <i class="bi bi-house-heart"></i>
            </div>
        </div>

    </div>

</section>

<!-- MISSION -->

<section class="about-section">

    <div class="container">

        <div class="about-grid">

            <div class="about-box">

                <div class="icon-circle">
                    <i class="bi bi-bullseye"></i>
                </div>

                <h3>Our Mission</h3>

                <p>Provide affordable, secure and accessible student accommodation through modern digital solutions.</p>

            </div>

            <div class="about-box">

                <div class="icon-circle">
                    <i class="bi bi-eye"></i>
                </div>

                <h3>Our Vision</h3>

                <p>Become a trusted digital accommodation platform for students in Umbilo, Durban.</p>

            </div>

        </div>

    </div>

</section>

<!-- WHY CHOOSE US -->

<section class="about-section">

    <div class="container">

        <div class="section-heading">

            <h2>Why Students Choose Us</h2>

            <p>Everything you need in one place.</p>

        </div>

        <div class="about-grid">

            <div class="about-box">

                <div class="icon-circle">
                    <i class="bi bi-house-door"></i>
                </div>

                <h3>Modern Accommodation</h3>

                <p>Comfortable rooms designed for student living.</p>

            </div>

            <div class="about-box">

                <div class="icon-circle">
                    <i class="bi bi-shield-check"></i>
                </div>

                <h3>Secure Platform</h3>

                <p>Applications, payments and maintenance requests managed through a single dashboard.</p>

            </div>

            <div class="about-box">

                <div class="icon-circle">
                    <i class="bi bi-lightning-charge"></i>
                </div>

                <h3>Quick Applications</h3>

                <p>Apply online without unnecessary paperwork.</p>

            </div>

        </div>

    </div>

</section>

<!-- CTA -->

<div class="container">

    <div class="about-cta">

        <h2>Ready to Find Your Student Home?</h2>

        <p>Browse available rooms and start your application with Umbilo Rentals.</p>

        @Html.ActionLink(
            "Browse Rooms",
            "Index",
            "Rooms",
            null,
            new { @class = "btn-primary-glass" })

    </div>

</div>
