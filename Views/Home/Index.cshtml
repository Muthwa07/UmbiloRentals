@{
        ViewBag.Title = "Home";
}

<div class="home-page">

    <!-- HERO SECTION -->
    <section class="home-hero">

        <div class="hero-content">

            <h1>UMBILO RENTALS</h1>

            <h2>Comfortable Living. Convenient Location.</h2>

            <p>
                Find a place you can comfortably call home.
                Quality accommodation in a secure environment.
            </p>

            <a href="@Url.Action("Index", "Rooms")" class="home-button">
                VIEW AVAILABLE ROOMS
            </a>

        </div>

    </section>


    <!-- WHY CHOOSE US -->
    <section class="why-us">

        <div class="home-section-heading">

            <h2>WHY CHOOSE US?</h2>

            <p>
                We provide comfortable and convenient accommodation
                designed around the needs of our residents.
            </p>

        </div>


        <div class="why-us-grid">

            <!-- CARD 1 -->
            <div class="why-us-card">

                <div class="why-icon">
                    🏠
                </div>

                <h3>COMFORTABLE LIVING</h3>

                <p>
                    Well-maintained accommodation designed to give
                    residents a comfortable place to call home.
                </p>

            </div>


            <!-- CARD 2 -->
            <div class="why-us-card">

                <div class="why-icon">
                    🔒
                </div>

                <h3>SAFE & SECURE</h3>

                <p>
                    A secure living environment where residents
                    can feel comfortable and protected.
                </p>

            </div>


            <!-- CARD 3 -->
            <div class="why-us-card">

                <div class="why-icon">
                    📍
                </div>

                <h3>CONVENIENT LOCATION</h3>

                <p>
                    Easily browse available rooms and manage your
                    accommodation application online.
                </p>

            </div>

        </div>

    </section>


    <!-- CALL TO ACTION -->
    <section class="home-cta">

        <h2>Ready to Find Your New Home?</h2>

        <p>
            Browse our available rooms and find accommodation
            that suits your needs.
        </p>

        <a href="@Url.Action("Index", "Rooms")" class="home-button">
            EXPLORE ROOMS
        </a>

    </section>

</div>