@{
    ViewBag.Title = "Umbilo Rentals";
}

<div class="hero-section">

    <div class="hero-background"></div>

    <div class="hero-overlay"></div>

    <div class="hero-content">

        <div class="welcome-pill">
            💙 Welcome Home
        </div>

        <h1>
            Find Your Perfect
            <span>Place to Live</span>
        </h1>

        <p>
            Modern. Secure. Comfortable.
            Discover premium student accommodation in Umbilo with
            verified rooms, simple applications and quick support.
        </p>

        <div class="hero-buttons">

            @Html.ActionLink(
                "Browse Rooms →",
                "Index",
                "Rooms",
                null,
                new { @class = "hero-btn-primary" })

            @if (Session["UserID"] != null &&
                 (int)Session["RoleID"] == 1)
            {
                @Html.ActionLink(
                    "My Applications",
                    "Index",
                    "Applications",
                    null,
                    new { @class = "hero-btn-secondary" })
            }
            else
            {
                @Html.ActionLink(
                    "Create Account",
                    "Register",
                    "Account",
                    null,
                    new { @class = "hero-btn-secondary" })
            }

        </div>

    </div>

</div>

<div class="stats-bar">

    <div class="stat-card">

        <div class="stat-icon">🏠</div>

        <div>

            <strong>50+</strong>

            <span>Available Rooms</span>

        </div>

    </div>

    <div class="stat-card">

        <div class="stat-icon">🛡</div>

        <div>

            <strong>24/7</strong>

            <span>Security</span>

        </div>

    </div>

    <div class="stat-card">

        <div class="stat-icon">⭐</div>

        <div>

            <strong>98%</strong>

            <span>Resident Satisfaction</span>

        </div>

    </div>

    <div class="stat-card">

        <div class="stat-icon">📍</div>

        <div>

            <strong>Umbilo</strong>

            <span>Prime Location</span>

        </div>

    </div>

</div>

<div class="features-section">

    <div class="section-title">

        <h2>Why Choose Umbilo Rentals?</h2>

        <p>Everything students need in one place.</p>

    </div>

    <div class="feature-grid">

        <div class="feature-card">

            <div class="feature-icon">🏡</div>

            <h3>Quality Rooms</h3>

            <p>Modern, clean and affordable accommodation.</p>

        </div>

        <div class="feature-card">

            <div class="feature-icon">⚡</div>

            <h3>Quick Applications</h3>

            <p>Apply online and track your application instantly.</p>

        </div>

        <div class="feature-card">

            <div class="feature-icon">🔧</div>

            <h3>Easy Support</h3>

            <p>Report maintenance issues directly from your dashboard.</p>

        </div>

    </div>

</div>