@{
    ViewBag.Title = "Refund Policy";
}

<div class="legal-page">

    <div class="legal-header">
        <h1>Refund Policy</h1>
        <p class="legal-updated">Last updated: @DateTime.Now.ToString("d MMMM yyyy")</p>
    </div>

    <div class="legal-notice legal-notice-warning">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <p>
            <strong>Template notice:</strong> the specific timeframes and conditions
            below are placeholders. Replace them with your actual refund rules
            before this platform is used for real payments.
        </p>
    </div>

    <section>
        <h2>1. Application and booking payments</h2>
        <p>
            [Placeholder — specify whether an application/booking payment is
            refundable, e.g. "fully refundable if cancelled within 48 hours of
            payment" or "non-refundable once a room has been allocated."]
        </p>
    </section>

    <section>
        <h2>2. Monthly rent payments</h2>
        <p>
            [Placeholder — specify your policy on overpayments, duplicate payments,
            or rent paid after move-out, and how quickly refunds are processed.]
        </p>
    </section>

    <section>
        <h2>3. How refunds are processed</h2>
        <p>
            Approved refunds are returned via PayFast to the original payment
            method used. Processing times depend on PayFast and your bank, and can
            take [placeholder — e.g. "5–10 business days"].
        </p>
    </section>

    <section>
        <h2>4. Requesting a refund</h2>
        <p>
            To request a refund, email
            <a href="mailto:info@umbilorentals.co.za">info@umbilorentals.co.za</a>
            with your name, the room/application reference, and the reason for the
            request.
        </p>
    </section>

    <section>
        <h2>5. Non-refundable items</h2>
        <p>
            [Placeholder — list anything you consider non-refundable, e.g. damage
            deposits withheld for confirmed damage, or administration fees.]
        </p>
    </section>

</div>
