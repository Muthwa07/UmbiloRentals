<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - Umbilo Rentals</title>

    @Styles.Render("~/Content/css")

    @Scripts.Render("~/bundles/modernizr")

</head>

@{
    string currentController =
        ViewContext.RouteData.Values["controller"].ToString();

    string currentAction =
        ViewContext.RouteData.Values["action"].ToString();

    Func<string, string, string> activeClass = (controller, action) =>
    {
        bool active = currentController.Equals(
            controller,
            StringComparison.OrdinalIgnoreCase);

        if (!string.IsNullOrEmpty(action))
        {
            active = active &&
                currentAction.Equals(
                    action,
                    StringComparison.OrdinalIgnoreCase);
        }

        return active ? "active" : "";
    };

    string roleTheme = "theme-guest";
    string roleLabel = "Guest";

    if (Session["RoleID"] != null)
    {
        switch ((int)Session["RoleID"])
        {
            case 1:
                roleTheme = "theme-applicant";
                roleLabel = "Applicant";
                break;

            case 2:
                roleTheme = "theme-admin";
                roleLabel = "Administrator";
                break;

            case 3:
                roleTheme = "theme-maintenance";
                roleLabel = "Maintenance";
                break;
        }
    }
}

<body class="@roleTheme">
    <!-- ================= NAVBAR ================= -->

    <nav class="floating-navbar">

        <div class="nav-container">

            <div class="brand">

                <div class="brand-logo">
                    <icon name=building color=info />
                </div>

                @Html.ActionLink(
                    "Umbilo Rentals",
                    "Index",
                    "Home",
                    null,
                    new { @class = "brand-name" })

            </div>

            <div class="nav-links">

                <a href="@Url.Action("Index","Home")"
                   class="@activeClass("Home","Index")">
                    Home
                </a>

                @if (Session["UserID"] == null)
                {
                    <a href="@Url.Action("About","Home")"
                       class="@activeClass("Home","About")">
                        About
                    </a>
                }

                @if (Session["RoleID"] == null ||
                    (Session["RoleID"] != null && (int)Session["RoleID"] == 1))
                {
                    <a href="@Url.Action("Index","Rooms")"
                       class="@activeClass("Rooms","Index")">
                        Rooms
                    </a>
                }

                @if (Session["RoleID"] != null && (int)Session["RoleID"] == 1)
                {
                    <a href="@Url.Action("Dashboard","Account")">Dashboard</a>
                    <a href="@Url.Action("Profile","Account")">Profile</a>
                    <a href="@Url.Action("Index","Applications")">Applications</a>
                    <a href="@Url.Action("History","Payments")">Payments</a>
                    <a href="@Url.Action("Report","Maintenance")">Maintenance</a>
                }

                @if (Session["RoleID"] != null && (int)Session["RoleID"] == 2)
                {
                    <a href="@Url.Action("Index","Admin")">Admin</a>
                    <a href="@Url.Action("Applications","Admin")">Applications</a>
                    <a href="@Url.Action("Rooms","Admin")">Rooms</a>
                    <a href="@Url.Action("Payments","Admin")">Payments</a>
                }

                @if (Session["RoleID"] != null && (int)Session["RoleID"] == 3)
                {
                    <a href="@Url.Action("Index","Maintenance")">Dashboard</a>
                }

            </div>

            <div class="nav-right">

                @if (Session["RoleID"] != null && (int)Session["RoleID"] == 1)
                {
                    <a href="@Url.Action("Index","Notifications")"
                       class="nav-icon">

                        <icon name=bell />

                        @if (ViewBag.NotificationCount > 0)
                        {
                            <span class="notification-dot">
                                @ViewBag.NotificationCount
                            </span>
                        }

                    </a>
                }

                @if (Session["UserID"] != null)
                {
                    <div class="user-chip">

                        <div class="avatar">
                            @Session["UserName"].ToString().Substring(0, 1)
                        </div>

                        <div class="user-info">

                            <strong>
                                @Session["UserName"].ToString().Split(' ')[0]
                            </strong>

                            <small>@roleLabel</small>

                        </div>

                    </div>

                    @Html.ActionLink(
                        "Logout",
                        "Logout",
                        "Account",
                        null,
                        new { @class = "logout-modern" })
                }
                else
                {
                    @Html.ActionLink(
                        "Login",
                        "Login",
                        "Account",
                        null,
                        new { @class = "login-modern" })
                }

            </div>

        </div>

    </nav>

    <!-- =============== CONTENT =============== -->

    <div class="page-shell">

        <main class="page-container">

            @Html.Partial("_Alerts")

            @RenderBody()

        </main>

    </div>

    <!-- ================= FOOTER ================= -->

    <footer class="glass-footer">

        <div class="footer-top">

            <div class="footer-brand">

                <div class="footer-logo">
                    <icon name=building color=info size=lg />
                </div>

                <div>

                    <h3>Umbilo Rentals</h3>

                    <p>Find secure, comfortable accommodation with confidence.</p>

                </div>

            </div>

            <div class="footer-links">

                @Html.ActionLink("Home", "Index", "Home")
                @Html.ActionLink("Rooms", "Index", "Rooms")

                @if (Session["UserID"] == null)
                {
                    @Html.ActionLink("About", "About", "Home")
                }
                else if ((int)Session["RoleID"] == 1)
                {
                    @Html.ActionLink("Dashboard", "Dashboard", "Account")
                }

            </div>

            <div class="footer-contact">

                <span>
                    <icon name=map-pin color=info inline />
                    Umbilo, Durban
                </span>

                <span>
                    <icon name=mail color=info inline />
                    info@umbilorentals.co.za
                </span>

            </div>

        </div>

        <div class="footer-bottom">

            © @DateTime.Now.Year
            <span>Umbilo Rentals</span>.
            All rights reserved.

        </div>

    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>

</html>