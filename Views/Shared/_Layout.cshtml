<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - Umbilo Rentals</title>

    <link rel="icon" type="image/svg+xml" href="@Url.Content("~/Content/images/logo.svg")" />
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")" />
    <link rel="shortcut icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")" />

    @Styles.Render("~/Content/css")

    @Scripts.Render("~/bundles/modernizr")

</head>

@{
    string currentController =
        ViewContext.RouteData.Values["controller"].ToString();

    string currentAction =
        ViewContext.RouteData.Values["action"].ToString();

    Func<string, string, string> activeClass = (controller, action) =>
    {
        bool active = currentController.Equals(
            controller,
            StringComparison.OrdinalIgnoreCase);

        if (!string.IsNullOrEmpty(action))
        {
            active = active &&
                currentAction.Equals(
                    action,
                    StringComparison.OrdinalIgnoreCase);
        }

        return active ? "active" : "";
    };

    string roleTheme = "theme-guest";
    string roleLabel = "Guest";

    if (Session["RoleID"] != null)
    {
        switch ((int)Session["RoleID"])
        {
            case 1:
                roleTheme = "theme-applicant";
                roleLabel = "Applicant";
                break;

            case 2:
                roleTheme = "theme-admin";
                roleLabel = "Administrator";
                break;

            case 3:
                roleTheme = "theme-maintenance";
                roleLabel = "Maintenance";
                break;
        }
    }
}

<body class="@roleTheme">
    <!-- ================= NAVBAR (guests only) ================= -->

    @if (Session["UserID"] == null)
    {
        <nav class="top-navbar">

            <div class="nav-container">

                <div class="brand">

                    <div class="brand-logo">
                        <img src="@Url.Content("~/Content/images/logo.svg")" alt="" />
                    </div>

                    @Html.ActionLink(
                        "Umbilo Rentals",
                        "Index",
                        "Home",
                        null,
                        new { @class = "brand-name" })

                </div>

                <div class="nav-links">

                    <a href="@Url.Action("Index","Home")"
                       class="@activeClass("Home","Index")">
                        Home
                    </a>

                    <a href="@Url.Action("About","Home")"
                       class="@activeClass("Home","About")">
                        About
                    </a>

                    <a href="@Url.Action("Index","Rooms")"
                       class="@activeClass("Rooms","Index")">
                        Rooms
                    </a>

                </div>

                <div class="nav-right">

                    @Html.ActionLink(
                        "Login",
                        "Login",
                        "Account",
                        null,
                        new { @class = "login-modern" })

                </div>

            </div>

        </nav>
    }

    <!-- =============== CONTENT =============== -->

    @{ bool showSidebar = Session["RoleID"] != null; }

    <div class="app-shell @(showSidebar ? "has-sidebar" : "")">

        @if (showSidebar)
        {
            @Html.Partial("_Sidebar")
            <div id="sidebarBackdrop" class="sidebar-backdrop" tabindex="-1"></div>
        }

        <div class="page-shell">

            <main class="page-container">

                @Html.Partial("_Alerts")

                @RenderBody()

            </main>

        </div>

    </div>

    <!-- ================= FOOTER ================= -->

    <footer class="glass-footer">

        <div class="footer-top">

            <div class="footer-brand">

                <div class="footer-logo">
                    <img src="@Url.Content("~/Content/images/logo.svg")" alt="Umbilo Rentals" />
                </div>

                <div>

                    <h3>Umbilo Rentals</h3>

                    <p>Find secure, comfortable accommodation with confidence.</p>

                    <p class="footer-disclaimer">
                        Umbilo Rentals is a student project and demonstration platform.
                    </p>

                </div>

            </div>

            <div class="footer-links">

                <h4>Site</h4>

                @Html.ActionLink("Home", "Index", "Home")
                @Html.ActionLink("Rooms", "Index", "Rooms")

                @if (Session["UserID"] == null)
                {
                    @Html.ActionLink("About", "About", "Home")
                }
                else if ((int)Session["RoleID"] == 1)
                {
                    @Html.ActionLink("Dashboard", "Dashboard", "Account")
                }

            </div>

            <div class="footer-links">

                <h4>Legal</h4>

                @Html.ActionLink("Privacy Policy", "Privacy", "Legal")
                @Html.ActionLink("Terms &amp; Conditions", "Terms", "Legal")
                @Html.ActionLink("Cookie Policy", "Cookies", "Legal")
                @Html.ActionLink("Refund Policy", "Refunds", "Legal")

            </div>

            <div class="footer-contact">

                <span>
                    <i class="bi bi-geo-alt-fill"></i>
                    Umbilo, Durban
                </span>

                <span>
                    <i class="bi bi-envelope-fill"></i>
                    info@umbilorentals.co.za
                </span>

            </div>

        </div>

        <div class="footer-bottom">

            © @DateTime.Now.Year
            <span>Umbilo Rentals</span>.
            All rights reserved.

        </div>

    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script>
        (function () {
            var toggle = document.getElementById("sidebarToggle");
            var sidebar = document.getElementById("appSidebar");
            var shell = document.querySelector(".app-shell");
            var backdrop = document.getElementById("sidebarBackdrop");

            if (!toggle || !sidebar || !shell) { return; }

            function isMobile() {
                return window.matchMedia("(max-width: 900px)").matches;
            }

            function applyState(open) {
                // On desktop "open" means expanded (not collapsed).
                // On mobile "open" means the drawer is visible.
                var collapsedClass = isMobile() ? open : !open;
                shell.classList.toggle("sidebar-collapsed", collapsedClass);
                toggle.setAttribute("aria-expanded", open.toString());
                toggle.setAttribute(
                    "aria-label",
                    open ? "Close navigation menu" : "Open navigation menu"
                );
            }

            function currentlyOpen() {
                var collapsed = shell.classList.contains("sidebar-collapsed");
                return isMobile() ? collapsed : !collapsed;
            }

            var savedCollapsed = localStorage.getItem("umbilo-sidebar-collapsed") === "true";
            applyState(isMobile() ? false : !savedCollapsed);

            toggle.addEventListener("click", function () {
                var open = !currentlyOpen();
                applyState(open);
                if (!isMobile()) {
                    localStorage.setItem("umbilo-sidebar-collapsed", (!open).toString());
                }
                if (open && isMobile()) {
                    sidebar.querySelector(".sidebar-link").focus();
                }
            });

            if (backdrop) {
                backdrop.addEventListener("click", function () {
                    applyState(false);
                    toggle.focus();
                });
            }

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && isMobile() && currentlyOpen()) {
                    applyState(false);
                    toggle.focus();
                }
            });
        })();
    </script>

    @RenderSection("scripts", required: false)

</body>

</html>