<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - Umbilo Rentals</title>

    @Styles.Render("~/Content/css")

    @Scripts.Render("~/bundles/modernizr")

</head>

<body>

    @{
        string currentController =
            ViewContext.RouteData.Values["controller"].ToString();

        string currentAction =
            ViewContext.RouteData.Values["action"].ToString();

        Func<string, string, string> activeClass = (controller, action) =>
        {
            bool active =
                currentController.Equals(controller,
                    StringComparison.OrdinalIgnoreCase);

            if (!string.IsNullOrEmpty(action))
            {
                active = active &&
                    currentAction.Equals(action,
                        StringComparison.OrdinalIgnoreCase);
            }

            return active ? "active" : "";
        };
    }

    <!-- ================= NAVBAR ================= -->

    <nav class="glass-navbar">

        <div class="glass-nav-inner">

            <div class="brand-section">

                <div class="brand-icon">
                    <icon name=building color=info />
                </div>

                @Html.ActionLink(
                    "Umbilo Rentals",
                    "Index",
                    "Home",
                    null,
                    new { @class = "brand-text" })

            </div>

            <div class="nav-pill">

                <a href="@Url.Action("Index","Home")"
                   class="@activeClass("Home","Index")">
                    <icon name=home inline /> Home
                </a>

                @if (Session["UserID"] == null)
                {
                    <a href="@Url.Action("About","Home")"
                       class="@activeClass("Home","About")">
                        <icon name=info inline /> About
                    </a>
                }

                @if (Session["RoleID"] == null ||
                    (Session["RoleID"] != null && (int)Session["RoleID"] == 1))
                {
                    <a href="@Url.Action("Index","Rooms")"
                       class="@activeClass("Rooms","Index")">
                        <icon name=building inline /> Rooms
                    </a>
                }

                @if (Session["UserID"] != null &&
                    (int)Session["RoleID"] == 1)
                {
                    <a href="@Url.Action("Dashboard","Account")"
                       class="@activeClass("Account","Dashboard")">
                        <icon name=layout-dashboard inline /> Dashboard
                    </a>

                    <a href="@Url.Action("Profile","Account")"
                       class="@activeClass("Account","Profile")">
                        <icon name=circle-user inline /> Profile
                    </a>

                    <a href="@Url.Action("Index","Applications")"
                       class="@activeClass("Applications","Index")">
                        <icon name=clipboard inline /> My Applications
                    </a>
                }

                @if (Session["UserID"] != null &&
                    (int)Session["RoleID"] == 2)
                {
                    <a href="@Url.Action("Index","Admin")"
                       class="@activeClass("Admin","Index")">
                        <icon name=shield-check inline /> Admin
                    </a>

                    <a href="@Url.Action("Applications","Admin")"
                       class="@activeClass("Admin","Applications")">
                        <icon name=clipboard inline /> Applications
                    </a>

                    <a href="@Url.Action("Rooms","Admin")"
                       class="@activeClass("Admin","Rooms")">
                        <icon name=building inline /> Rooms
                    </a>

                    <a href="@Url.Action("Payments","Admin")"
                       class="@activeClass("Admin","Payments")">
                        <icon name=credit-card inline /> Payments
                    </a>

                    <a href="@Url.Action("Maintenance","Admin")"
                       class="@activeClass("Admin","Maintenance")">
                        <icon name=wrench inline /> Maintenance
                    </a>
                }

            </div>

            <div class="nav-actions">

                @if (Session["UserID"] != null &&
(int)Session["RoleID"] == 1)
                {
                    <a href="@Url.Action("Index","Notifications")"
                       class="notification-bubble @(ViewBag.NotificationCount > 0 ? "has-notifications" : "")">

                        <icon name=bell />

                        @if (ViewBag.NotificationCount > 0)
                        {
                            <span class="notification-dot">
                                @(ViewBag.NotificationCount > 9
                ? "9+"
                : ViewBag.NotificationCount.ToString())
                            </span>
                        }

                    </a>

                    <div class="profile-bubble">

                        <div class="profile-avatar">
                            @Session["UserName"].ToString().Substring(0, 1)
                        </div>

                        <span class="profile-name">
                            @Session["UserName"].ToString().Split(' ')[0]
                        </span>

                    </div>
                }

                @if (Session["UserID"] != null)
                {
                    @Html.ActionLink(
                        "Logout",
                        "Logout",
                        "Account",
                        null,
                        new { @class = "logout-btn" })
                }
                else
                {
                    @Html.ActionLink(
                        "Login",
                        "Login",
                        "Account",
                        null,
                        new { @class = "logout-btn" })
                }

            </div>

        </div>

    </nav>

    <!-- =============== CONTENT =============== -->

    <div class="page-shell">

        <main class="page-container">

            @RenderBody()

        </main>

    </div>

    <!-- ================= FOOTER ================= -->

    <footer class="glass-footer">

        <div class="footer-top">

            <div class="footer-brand">

                <div class="footer-logo">
                    🏢
                </div>

                <div>

                    <h3>Umbilo Rentals</h3>

                    <p>Modern student accommodation made simple.</p>

                </div>

            </div>

            <div class="footer-links">

                @Html.ActionLink("Home", "Index", "Home")
                @Html.ActionLink("Rooms", "Index", "Rooms")

                @if (Session["UserID"] == null)
                {
                    @Html.ActionLink("About", "About", "Home")
                }
                else if ((int)Session["RoleID"] == 1)
                {
                    @Html.ActionLink("Dashboard", "Dashboard", "Account")
                }

            </div>

            <div class="footer-contact">

                <span>📍 Umbilo, Durban</span>

                <span>📧 info@umbilorentals.co.za</span>

            </div>

        </div>

        <div class="footer-bottom">

            © @DateTime.Now.Year
            <span>Umbilo Rentals</span>.
            All rights reserved.

        </div>

    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>

</html>