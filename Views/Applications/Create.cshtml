@{
    ViewBag.Title = "Apply for Room";
}

<div class="account-page">

    <div class="account-card">

        <div class="account-header">

            <h1>Apply for Room</h1>

            <p>
                Complete your application for Room @ViewBag.RoomNumber
            </p>

        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }

        @using (Html.BeginForm(
            "Create",
            "Applications",
            FormMethod.Post,
            new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="roomID"
                   value="@ViewBag.RoomID" />

            <div class="form-group">

                <label>Room</label>

                <input type="text"
                       class="form-control"
                       value="Room @ViewBag.RoomNumber"
                       readonly />

            </div>

            <div class="form-group">

                <label for="document">
                    Supporting Document
                </label>

                <input type="file"
                       name="document"
                       id="document"
                       class="form-control"
                       accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                       required />

                <small style="color:#666;">
                    PDF, Word, JPG or PNG files only.
                    Maximum size: 10 MB.
                </small>

            </div>

            <div class="form-group">

                <label>Status</label>

                <input type="text"
                       class="form-control"
                       value="Pending"
                       readonly />

            </div>

            <button type="submit"
                    class="btn-register">
                Submit Application
            </button>

        }

        <div class="account-footer">

            @Html.ActionLink(
                "Back to Available Rooms",
                "Index",
                "Rooms"
            )

        </div>

    </div>

</div>