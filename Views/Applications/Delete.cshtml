@model UmbiloRentals.Models.Application

@{
    ViewBag.Title = "Delete Application";
}

<div class="account-page">

    <div class="account-card">

        <div class="account-header">

            <h1>Delete Application</h1>

            <p>
                Are you sure you want to delete this application?
            </p>

        </div>

        <div class="form-group">

            <label>Application ID</label>

            <input type="text"
                   class="form-control"
                   value="@Model.ApplicationID"
                   readonly />

        </div>

        <div class="form-group">

            <label>Room ID</label>

            <input type="text"
                   class="form-control"
                   value="@Model.RoomID"
                   readonly />

        </div>

        <div class="form-group">

            <label>Status</label>

            <input type="text"
                   class="form-control"
                   value="@Model.Status"
                   readonly />

        </div>

        <div class="form-group">

            <label>Date Applied</label>

            <input type="text"
                   class="form-control"
                   value="@Model.DateApplied"
                   readonly />

        </div>

        @using (Html.BeginForm(
            "Delete",
            "Applications",
            new { id = Model.ApplicationID },
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-danger">
                Delete Application
            </button>

            @Html.ActionLink(
                "Cancel",
                "Index",
                "Applications",
                null,
                new { @class = "btn btn-default" }
            )
        }

    </div>

</div>