@model UmbiloRentals.Models.Application

@{
    ViewBag.Title = "Edit Application";
}

<div class="account-page">

    <div class="account-card">

        <div class="account-header">

            <h1>Edit Application</h1>

            <p>Update your supporting document.</p>

        </div>

        @using (Html.BeginForm(
            "Edit",
            "Applications",
            FormMethod.Post,
            new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="ApplicationID"
                   value="@Model.ApplicationID" />

            <div class="form-group">

                <label>Room</label>

                <input class="form-control"
                       value="Room @ViewBag.RoomNumber"
                       readonly />

            </div>

            <div class="form-group">

                <label>Current Status</label>

                <input class="form-control"
                       value="@Model.Status"
                       readonly />

            </div>

            <div class="form-group">

                <label>Replace Supporting Document</label>

                <input type="file"
                       name="document"
                       class="form-control"
                       accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />

                <small>
                    Leave empty to keep your current document.
                </small>

            </div>

            <button class="btn-register">
                Save Changes
            </button>
        }

    </div>

</div>