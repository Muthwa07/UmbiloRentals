```cshtml
@model IEnumerable<UmbiloRentals.Models.Application>

@{
    ViewBag.Title = "My Applications";

    var roomLookup = ViewBag.RoomLookup as Dictionary<int, UmbiloRentals.Models.Room>;
}

<div class="applications-page">

    <div class="page-header">

        <div>
            <h1>My Applications</h1>

            <p>
                Track every accommodation application in one place.
            </p>
        </div>

        <div class="application-count">
            @Model.Count() Applications
        </div>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state glass-card">

            <div class="empty-icon">
                🏢
            </div>

            <h2>No applications yet</h2>

            <p>
                Browse available rooms and submit your first application.
            </p>

            @Html.ActionLink(
                "Browse Rooms",
                "Index",
                "Rooms",
                null,
                new { @class = "btn-auth" }
            )

        </div>
    }
    else
    {
        <div class="application-card-grid">

            @foreach (var item in Model)
            {
                UmbiloRentals.Models.Room room = null;

                if (roomLookup != null &&
                    item.RoomID.HasValue &&
                    roomLookup.ContainsKey(item.RoomID.Value))
                {
                    room = roomLookup[item.RoomID.Value];
                }

                var status = item.Status ?? "Pending";
                var statusClass = status.ToLower().Replace(" ", "-");

                <div class="application-card glass-card">

                    @if (room != null && !string.IsNullOrEmpty(room.Photo))
                    {
                        <img src="@Url.Content("~/Content/RoomImages/" + room.Photo)"
                             class="application-card-image"
                             alt="Room @(room.RoomNumber)" />
                    }
                    else
                    {
                        <div class="application-card-placeholder">
                            <div class="placeholder-icon">🏠</div>
                            <span>Room Image</span>
                        </div>
                    }

                    <div class="application-card-body">

                        <div class="card-top">

                            <h3>
                                @(room != null
                                    ? "Room " + room.RoomNumber
                                    : "Accommodation Room")
                            </h3>

                            <span class="status-chip @statusClass">
                                @status
                            </span>

                        </div>

                        @if (room != null)
                        {
                            <div class="price-row">

                                <strong>
                                    R @room.MonthlyRent
                                </strong>

                                <span>per month</span>

                            </div>
                        }

                        <div class="timeline">

                            <div class="timeline-item complete">
                                <span class="timeline-icon">✓</span>
                                <span>Application Submitted</span>
                            </div>

                            <div class="timeline-item
                                @(status == "Pending" ? "current" : "complete")">

                                <span class="timeline-icon">
                                    @(status == "Pending" ? "◷" : "✓")
                                </span>

                                <span>Under Review</span>

                            </div>

                            <div class="timeline-item
                                @(status == "Approved"
                                    ? "complete"
                                    : status == "Rejected"
                                        ? "rejected"
                                        : "")">

                                <span class="timeline-icon">
                                    @(status == "Approved"
                                        ? "✓"
                                        : status == "Rejected"
                                            ? "×"
                                            : "○")
                                </span>

                                <span>Final Decision</span>

                            </div>

                        </div>

                        <div class="application-meta">

                            <p>
                                <span class="meta-icon">📅</span>

                                <strong>Applied:</strong>

                                @(item.DateApplied.HasValue
                                    ? item.DateApplied.Value.ToString("dd MMM yyyy")
                                    : "Date unavailable")
                            </p>

                            <p>
                                <span class="meta-icon">📄</span>

                                Supporting document uploaded
                            </p>

                        </div>

                        <div class="application-actions">

                            @Html.ActionLink(
                                "View",
                                "Details",
                                new { id = item.ApplicationID },
                                new { @class = "btn-view" }
                            )

                            @if (status == "Pending")
                            {
                                @Html.ActionLink(
                                    "Withdraw",
                                    "Delete",
                                    new { id = item.ApplicationID },
                                    new { @class = "btn-withdraw" }
                                )
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
```
