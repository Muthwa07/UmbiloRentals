
@model IEnumerable<UmbiloRentals.Models.Application>

@{
    ViewBag.Title = "My Applications";

    var roomLookup = ViewBag.RoomLookup as Dictionary<int, UmbiloRentals.Models.Room>;
}

<div class="applications-page">

    <div class="page-header">

        <div>
            <h1>My Applications</h1>

            <p>
                Track every accommodation application in one place.
            </p>
        </div>

        <div class="application-count">
            @Model.Count() Applications
        </div>

    </div>



    @if (!Model.Any())
    {
        <div class="empty-state glass-card">

            <div class="empty-icon">
                <i class="bi bi-building"></i>
            </div>

            <h2>No applications yet</h2>

            <p>
                Browse available rooms and submit your first application.
            </p>

            @Html.ActionLink(
                "Browse Rooms",
                "Index",
                "Rooms",
                null,
                new { @class = "btn-primary-glass" }
            )

        </div>
    }
    else
    {
        <div class="application-card-grid">

            @foreach (var item in Model)
            {
                UmbiloRentals.Models.Room room = null;

                if (roomLookup != null &&
                    item.RoomID.HasValue &&
                    roomLookup.ContainsKey(item.RoomID.Value))
                {
                    room = roomLookup[item.RoomID.Value];
                }

                var status = item.Status ?? "Pending";
                var statusClass = status.ToLower().Replace(" ", "-");

                <div class="application-card glass-card">

                    @if (room != null && !string.IsNullOrEmpty(room.Photo))
                    {
                        <img src="@Url.Content("~/Content/RoomImages/" + room.Photo)"
                             class="application-card-image"
                             alt="Room @(room.RoomNumber)" />
                    }
                    else
                    {
                        <div class="application-card-placeholder">
                            <div class="placeholder-icon"><i class="bi bi-house-door-fill"></i></div>
                            <span>Room Image</span>
                        </div>
                    }

                    <div class="application-card-body">

                        <div class="card-top">

                            <h3>
                                @(room != null
            ? "Room " + room.RoomNumber
            : "Accommodation Room")
                            </h3>

                            @if (status == "Approved")
                            {
                                <span class="status-chip reserved">
                                    Reserved
                                </span>
                            }
                            else
                            {
                                <span class="status-chip @statusClass">
                                    @status
                                </span>
                            }

                        </div>

                        @if (room != null)
                        {
                            <div class="price-row">

                                <strong>
                                    R @room.MonthlyRent
                                </strong>

                                <span>per month</span>

                            </div>
                        }

                    <div class="timeline">

                        <div class="timeline-item complete">
                            <span class="timeline-icon"><i class="bi bi-check-circle-fill"></i></span>
                            <span>Application Submitted</span>
                        </div>

                        <div class="timeline-item
                                @(status == "Pending" ? "current" : "complete")">

                            <span class="timeline-icon">
                                @(status == "Pending" ? Html.Raw("<i class=\"bi bi-hourglass-split\"></i>") : Html.Raw("<i class=\"bi bi-check-circle-fill\"></i>"))
                            </span>

                            <span>Under Review</span>

                        </div>

                        @if (status == "Approved")
                        {
                            <div class="timeline-item current">

                                <span class="timeline-icon">$</span>

                                <span>Awaiting Payment</span>

                            </div>
                        }
                        else
                        {
                            <div class="timeline-item
        @(status == "Rejected" ? "rejected" : status == "Withdrawn" ? "withdrawn" : "")">

                                <span class="timeline-icon">
                                    @(status == "Rejected" ? Html.Raw("<i class=\"bi bi-x-circle-fill\"></i>")
                                      : status == "Withdrawn" ? Html.Raw("<i class=\"bi bi-arrow-return-left\"></i>")
                                      : Html.Raw("○"))
                                </span>

                                <span>
                                    @(status == "Withdrawn" ? "Application Withdrawn" : "Final Decision")
                                </span>

                            </div>
                        }

                    </div>

                        <div class="application-meta">

                            <p>
                                <span class="meta-icon"><i class="bi bi-calendar-event"></i></span>

                                <strong>Applied:</strong>

                                @(item.DateApplied.HasValue
                                    ? item.DateApplied.Value.ToString("dd MMM yyyy")
                                    : "Date unavailable")
                            </p>

                            <p>
                                <span class="meta-icon"><i class="bi bi-file-earmark-text-fill"></i></span>

                                Supporting document uploaded
                            </p>

                        </div>

                        <div class="application-actions">

                            @Html.ActionLink(
                                "View",
                                "Details",
                                new { id = item.ApplicationID },
                                new { @class = "btn-view" }
                            )

                            @if (status == "Pending")
                            {
                                @Html.ActionLink(
                                    "Withdraw",
                                    "Delete",
                                    new { id = item.ApplicationID },
                                    new { @class = "btn-withdraw" }
                                )
                            }

                            @if (status == "Approved")
                            {
                                @Html.ActionLink(
                                    "Pay with PayFast",
                                    "PayNow",
                                    "Payments",
                                    new { applicationId = item.ApplicationID },
                                    new { @class = "btn-payfast" }
                                )
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
